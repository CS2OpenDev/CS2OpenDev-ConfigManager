<Project Sdk="Microsoft.NET.Sdk">

    <!-- acb's commands run in process against fake Steam folders in temp, temp undo stores and stand-ins for the
         processes, the administrator question and UAC. Nothing here restores into this machine's own Steam,
          registry, display or driver: the engine refuses to write a Windows or driver section in any test assembly
         (NoMachineWrites.cs), so an archive here that holds one is only planned or refused. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\CS2OpenDev.ConfigManager.Core.Tests\FakeSteam.cs" Link="Shared\FakeSteam.cs"/>
        <Compile Include="..\CS2OpenDev.ConfigManager.Core.Tests\Permissions.cs" Link="Shared\Permissions.cs"/>
        <Compile Include="..\CS2OpenDev.ConfigManager.Core.Tests\NoMachineWrites.cs" Link="Shared\NoMachineWrites.cs"/>
        <Compile Include="..\CS2OpenDev.ConfigManager.Core.Tests\FakeMachine.cs" Link="Shared\FakeMachine.cs"/>
        <Compile Include="..\CS2OpenDev.ConfigManager.Core.Tests\TestIdentity.cs" Link="Shared\TestIdentity.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\CS2OpenDev.ConfigManager.Cli\CS2OpenDev.ConfigManager.Cli.csproj"/>
        <ProjectReference Include="..\..\src\CS2OpenDev.ConfigManager.Core\CS2OpenDev.ConfigManager.Core.csproj"/>
        <ProjectReference Include="..\..\tools\CS2OpenDev.ConfigManager.IdentityIssuer\CS2OpenDev.ConfigManager.IdentityIssuer.csproj"/>
    </ItemGroup>

</Project>
