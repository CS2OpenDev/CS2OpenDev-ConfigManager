<Project Sdk="Microsoft.NET.Sdk">

    <!-- The identity level's key ceremony, run offline by the root key holders: make keys, write a delegation, add
         each holder's signature, print the roots, revocations and pins for IdentityTrust.Shipped. The commands are
         Ceremony in the issuer library, where the tests reach them. Never shipped; acb holds public keys only. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>acb-identity-keys</AssemblyName>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CS2OpenDev.ConfigManager.IdentityIssuer\CS2OpenDev.ConfigManager.IdentityIssuer.csproj"/>
    </ItemGroup>

</Project>
