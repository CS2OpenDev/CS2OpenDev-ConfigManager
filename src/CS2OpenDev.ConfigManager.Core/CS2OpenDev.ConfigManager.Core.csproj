<Project Sdk="Microsoft.NET.Sdk">

    <!-- Capture, restore, rules and the archive format, with nothing from DemoViewer.NET or Avalonia. The
         restorer and the DemoViewer.NET plugin share this one engine. The restorer ships Native AOT, so the
         trim and AOT analyzers run here. -->
    <PropertyGroup>
        <RootNamespace>CS2OpenDev.ConfigManager</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2"/>
        <!-- The words a generated seal passphrase is made of (EFF, CC BY 3.0 US; see THIRD-PARTY-NOTICES.md). -->
        <EmbeddedResource Include="Archive/eff-large-wordlist.txt" LogicalName="CS2OpenDev.ConfigManager.Archive.eff-large-wordlist.txt"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="CS2OpenDev.ConfigManager.Core.Tests"/>
        <InternalsVisibleTo Include="acb"/>
        <InternalsVisibleTo Include="CS2OpenDev.ConfigManager.Cli.Tests"/>
        <InternalsVisibleTo Include="CS2OpenDev.ConfigManager.DemoViewer.Tests"/>
        <InternalsVisibleTo Include="CS2OpenDev.ConfigManager.IdentityIssuer"/>
    </ItemGroup>

</Project>
